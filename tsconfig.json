{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/server", "src/shared", "tests", "vite.config.ts", "playwright.config.ts"]
}
