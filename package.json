{
  "name": "vitaworld-store",
  "version": "1.3.24",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --port 8788",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:demo": "wrangler d1 execute DB --local --file fixtures/demo.sql",
    "setup:local": "node scripts/local-setup.mjs",
    "release:source": "node scripts/package-release.mjs",
    "security:source": "node scripts/package-release.mjs --check-only",
    "deploy:live": "node scripts/deploy-live.mjs",
    "bench": "node scripts/load-test.mjs",
    "format": "prettier --write src tests scripts admin public package.json *.json *.ts README.md docs",
    "format:check": "prettier --check src tests scripts admin public package.json *.json *.ts README.md docs",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.10.0",
    "marked": "18.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.25.0",
    "miniflare": "^5.20261001.0-alpha",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "اختر عبارة تثبيت خاصة طويلة (24 حرفًا على الأقل). ستدخلها مرة واحدة في /admin لإنشاء حسابك. لا تشاركها ولا تضع فيها مفتاح مورد. مفاتيح التشفير تُنشأ تلقائيًا لكل متجر."
      },
      "DB": {
        "description": "قاعدة خاصة لهذا المتجر تحفظ الإعدادات والطلبات."
      },
      "MEDIA": {
        "description": "صور هذا المتجر؛ يلزم تفعيل R2 في حسابك."
      },
      "BACKUPS": {
        "description": "نسخ احتياطية مشفرة خاصة بهذا المتجر."
      }
    }
  }
}
